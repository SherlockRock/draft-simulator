DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=draft_simulator

GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

SESSION_SECRET=your-session-secret # crypto.randomBytes(32)
JWT_SECRET=your-jwt-secret # crypto.randomBytes(32)
REFRESH_TOKEN_SECRET=your-refresh-secret # crypto.randomBytes(32)
ENCRYPTION_KEY=your-encryption-secret # crypto.randomBytes(32)
SHARE_JWT_SECRET=your-share-jwt-secret # crypto.randomBytes(32)

INIT_VECTOR=your-iv-secret # crypto.randomBytes(16)

PORT=3000
BACKEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development or production

# Verbose per-request/per-event/per-query debug logging. Off unless "true".
# Leave unset in production: tracing.js mirrors every console.log into OTel,
# so this is expensive enough to stall the event loop under load.
DEBUG_LOGS=

# OpenTelemetry / Grafana Cloud (leave empty for local dev — disables telemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=firstpick-backend

# Sequelize pool (see config/database.js). Defaults shown.
DB_POOL_MAX=10
DB_POOL_ACQUIRE_MS=15000
DB_POOL_IDLE_MS=10000